# These same variable names hold different VALUES per environment once a
# staging deployment exists: local dev (.env.local), Vercel's staging
# branch, and Vercel Production each point at their own Supabase project
# and (where relevant) their own Resend key — never share production's
# values with local dev or staging. See scripts/build-bootstrap-sql.sh for
# bootstrapping a new Supabase project's schema from scratch.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-only — bypasses RLS. Powers instant passwordless signup from the
# landing page's lead-capture modal. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive report archival (service account + Shared Drive)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ID=your-shared-drive-id

# First-signup admin notification (sent via Resend's API)
RESEND_API_KEY=your-resend-api-key
NSS_WEBHOOK_SECRET=a-long-random-string-you-generate

# NRS (Needs Resonance Scan) email dev-safety guard. Defaults to "mock"
# whenever NODE_ENV !== "production", so local dev and preview deploys
# never call Resend for an NRS email unless explicitly set to "live" here.
# Leave unset in most environments.
# NRS_EMAIL_MODE=mock

# CRM lead intake — POST https://crm.boldlygobeyond.com/api/leads/intake on
# first-login onboarding completion. Ask Marc for the value; never invent one.
CRM_LEAD_INTAKE_API_KEY=your-crm-lead-intake-api-key

# Google Analytics 4 measurement ID (public — sent to the browser)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional — only needed if your local Chrome isn't at the default macOS
# path. Used for local PDF-generation dev only; production uses the bundled
# serverless Chromium binary (@sparticuz/chromium) automatically.
# CHROME_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
